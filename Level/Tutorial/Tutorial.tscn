[node name="Tutorial" type="Node2D"]
script = ExtResource("1_tutorial")
sky_colors = SubResource("Resource_sky")
intro_lines = Array[String](["You stir. Good. The void did not keep you. It lets very little go.", "I am what remains of this world's heart. When it shattered, I woke in the pieces.", "You have a bow-hand. An archer, then. The last one, I think. The wizards saw to the rest.", "You look lost. The rupture tore more than the land. Let me remind your body what it knows."])
outro_lines = Array[String](["Your hands remember, even if your mind does not.", "Beyond here, rifts tear through what is left of the world. Each one you cross, I feel a little less scattered.", "When the void grows too strong for you, it will send you back to me. Rest, then rise again.", "Come. I will show you what remains of home."])

