[sub_resource type="Resource" id="Resource_altar_data"]
script = ExtResource("3_data")
npc_name = "Blood Well"
dialogue_lines = Array[String](["The well is warm. Something below it is still breathing.", "Old blood, older stone. It remembers every hand that fed it.", "The surface ripples, though there is no wind."])
fixed_line = "Give it one of your hearts, and it will give you something worth carrying."
post_action_lines = Array[String](["The well drinks deep, then falls silent. Something rises in its place."])
action_button_labels = Array[String](["Offer a Heart"])
disappears = false
idle = true

