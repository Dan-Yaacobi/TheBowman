[sub_resource type="Resource" id="Resource_data"]
script = ExtResource("2_data")
npc_name = "Spirit of the World"
dialogue_lines = Array[String](["The islands drift apart, but they remember being whole. So do I.", "Every rift is a wound in the world. Each one you cross, I feel a little less scattered.", "You are the last of the archers. The bows of your people still wait somewhere in the void.", "When the void grows too strong for you, it will send you back to me. Rest, then rise again.", "I am what remains of this world's heart. Help me mend it."])
disappears = false
idle = true

