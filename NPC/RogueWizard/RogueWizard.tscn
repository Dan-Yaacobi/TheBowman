[sub_resource type="Resource" id="Resource_wizard"]
script = ExtResource("3_data")
npc_name = "Rogue Wizard"
dialogue_lines = Array[String](["Not every wizard bent the knee. Some of us just learned to hide better.", "We made these for your people, long before the cult took them back. I still remember how.", "Keep your voice down. The tower has long ears, even out here.", "Your gear hums with old craft. Let me wake the rest of it."])
fixed_line = "Give me one of your artifacts and some essence. It will come back stronger than it left."
post_action_lines = Array[String](["There. Older craft than the cult will ever understand.", "Don't thank me. Just get to the tower."])
action_button_labels = Array[String](["Reforge"])
metadata/_custom_type_script = "uid://bmi4eqninttxo"

