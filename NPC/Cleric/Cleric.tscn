[sub_resource type="Resource" id="Resource_02btb"]
script = ExtResource("2_sxjso")
npc_name = "Cleric"
dialogue_lines = Array[String](["The sky itself flows through you. I trust you will honour that.", "I require only coin. The sky levies a far greater toll.", "Be still a moment. The islands are patient. You should be too.", "Let the winds carry what burdens you. Now rise.", "What is broken can be mended. That is why I am here."])
fixed_line = "My blessing will expand your health and fill it to the brim."
post_action_lines = Array[String](["It is done. Now go, and do not waste what I have given you."])
action_button_labels = Array[String](["Bless (25 Gold)"])
