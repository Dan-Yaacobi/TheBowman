[sub_resource type="Shader" id="Shader_u6i21"]
code = "shader_type canvas_item;

//shard_count — how many pieces the sprite breaks into. Low values (4–6) give big chunky shards like thick glass or pottery. High values (20–30) give a fine shatter like thin ice or a mirror. Default 12 is a good middle ground for most items.
//spread — how far shards fly outward from the impact point. Low (0.3–0.6) keeps pieces close together, like something crumbling and falling in place. High (1.5–3.0) sends pieces flying dramatically. Tune this alongside gravity — high spread + low gravity = explosion outward, low spread + high gravity = pieces just drop.
//gravity — downward pull on the shards over time. Since it's multiplied by t² it accelerates naturally. Low (0.2–0.5) for something light like a leaf or paper. High (2.0–3.0) for something heavy like a rock or metal object.
//spin_amount — how much each shard rotates as it flies. 0 means pieces slide away flat which looks unnatural. Around 3–5 is realistic for most objects. Very high (8–10) gives a chaotic explosive feel.
//fade_start — at what point during the animation pieces start fading out. 0.2 means they start disappearing almost immediately. 0.8 means they stay visible for most of the animation and vanish at the end. Lower values hide the UV sampling artifacts better but feel less physical.
//gap_darkness — how dark the cracks between separating shards are. 0 means no visible cracks. 1.0 means fully black gaps. Keep it around 0.6–0.8 for a clean look.
//delay_variance — how staggered the shard movement is. 0 means all shards move together. 0.15–0.3 gives a natural fracture propagation feel.
//impact_point — the UV coordinate the break originates from. Default (0.5, 0.5) is center. If an arrow hits the left side of a crate, pass in something like (0.2, 0.5) so shards fly away from that side instead.

uniform float progress : hint_range(0.0, 1.0) = 0.0;
uniform int shard_count : hint_range(3, 30) = 12;
uniform float gravity : hint_range(0.0, 3.0) = 1.5;
uniform float spread : hint_range(0.0, 3.0) = 1.2;
uniform float spin_amount : hint_range(0.0, 10.0) = 4.0;
uniform float fade_start : hint_range(0.0, 1.0) = 0.4;
uniform float gap_darkness : hint_range(0.0, 1.0) = 0.8;
uniform float delay_variance : hint_range(0.0, 0.5) = 0.15;
uniform vec2 impact_point = vec2(0.5, 0.5);

vec2 hash2(vec2 p) {
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return fract(sin(p) * 43758.5453123);
}

void voronoi(vec2 uv, int count, out vec2 cell_id, out vec2 cell_seed_uv, out float border_dist) {
    float scale = float(count) * 0.5;
    vec2 scaled = uv * scale;
    vec2 cell = floor(scaled);
    vec2 local = fract(scaled);

    float min_dist = 8.0;
    float second_dist = 8.0;
    cell_id = vec2(0.0);
    cell_seed_uv = vec2(0.5);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 neighbor = vec2(float(x), float(y));
            vec2 h = hash2(cell + neighbor);
            vec2 point = h + neighbor;
            float d = length(point - local);
            if (d < min_dist) {
                second_dist = min_dist;
                min_dist = d;
                cell_id = cell + neighbor;
                cell_seed_uv = (cell + neighbor + h) / scale;
            } else if (d < second_dist) {
                second_dist = d;
            }
        }
    }
    border_dist = (second_dist - min_dist) * scale * 0.5;
}

mat2 rotate2d(float a) {
    float c = cos(a); float s = sin(a);
    return mat2(vec2(c, -s), vec2(s, c));
}

float burst(float t) {
    return 1.0 - pow(1.0 - t, 3.0);
}

void fragment() {
    vec2 uv = UV;

    vec2 cell_id;
    vec2 seed_uv;
    float border_dist;
    voronoi(uv, shard_count, cell_id, seed_uv, border_dist);

    vec2 rnd  = hash2(cell_id);
    vec2 rnd2 = hash2(cell_id + vec2(53.2, 31.7));
    vec2 rnd3 = hash2(cell_id + vec2(11.4, 97.6));
    vec2 rnd4 = hash2(cell_id + vec2(74.1, 43.9));

    float delay = rnd4.x * delay_variance;
    float t = clamp((progress - delay) / (1.0 - delay), 0.0, 1.0);

    float mass = mix(0.5, 1.5, rnd3.y);

    float impact_dist = length(seed_uv - impact_point);
    float velocity = mix(1.6, 0.5, clamp(impact_dist * 2.0, 0.0, 1.0)) / mass;

    vec2 base_dir = seed_uv - impact_point;
    float base_len = length(base_dir);
    vec2 away = base_len > 0.001
        ? base_dir / base_len
        : vec2(rnd.x - 0.5, rnd.y - 0.5) * 2.0;

    float scatter_angle = (rnd3.x - 0.5) * 1.4;
    float sc = cos(scatter_angle); float ss = sin(scatter_angle);
    away = mat2(vec2(sc, -ss), vec2(ss, sc)) * away;

    float bt = burst(t);

    vec2 offset;
    offset.x = away.x * spread * velocity * rnd2.x * bt;
    offset.y = away.y * spread * velocity * rnd2.y * bt + gravity * t * t;

    float angle = (rnd.x - 0.5) * spin_amount * velocity * bt;

    float shard_scale = 1.0 - t * 0.3 * rnd2.y;

    vec2 local_uv = (uv - seed_uv) / max(shard_scale, 0.01);
    vec2 sample_uv = rotate2d(-angle) * local_uv + seed_uv - offset;

    float gap = clamp(border_dist - progress * 0.3, 0.0, 1.0);
    float border_mask = smoothstep(0.0, 0.08, gap);

    float fade = 1.0 - smoothstep(fade_start, 1.0, t);

    float in_bounds = step(0.0, sample_uv.x) * step(sample_uv.x, 1.0)
                    * step(0.0, sample_uv.y) * step(sample_uv.y, 1.0);

    vec4 tex = texture(TEXTURE, clamp(sample_uv, vec2(0.0), vec2(1.0)));

    // Only show cracks once breaking has actually started
    float breaking = smoothstep(0.0, 0.02, progress);

    float gap_shadow = mix(1.0 - gap_darkness * breaking, 1.0, border_mask);

    COLOR = vec4(tex.rgb * gap_shadow, tex.a * mix(1.0, border_mask * fade, breaking) * in_bounds);
}"

