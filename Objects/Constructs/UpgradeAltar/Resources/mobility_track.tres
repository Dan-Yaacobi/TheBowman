4: 1
})
milestone_pool = Array[ExtResource("2_hvg0w")]([SubResource("Resource_djump_rw"), SubResource("Resource_airdraw_rw"), SubResource("Resource_dash_rw"), SubResource("Resource_footing_rw")])
offers_per_milestone = 1
