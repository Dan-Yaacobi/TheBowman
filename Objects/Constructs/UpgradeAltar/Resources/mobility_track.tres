[resource]
script = ExtResource("2_xw5hj")
id = &"mobility"
display_name = "Mobility"
cycle = Array[ExtResource("1_ljyyh")]([SubResource("Resource_move_a"), SubResource("Resource_dash_cd"), SubResource("Resource_move_b"), SubResource("Resource_dash_pw")])
