[gd_scene format=3]

[ext_resource type="Script" path="res://HUD/ColorScrollPicker/color_scroll_card.gd" id="1_card"]

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_none"]

[node name="ColorScrollCard" type="PanelContainer"]
custom_minimum_size = Vector2(230, 300)
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Icon" type="TextureRect" parent="Margin/VBox"]
texture_filter = 1
custom_minimum_size = Vector2(128, 128)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="NameLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Name"
horizontal_alignment = 1

[node name="LevelLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Lv 0  >  1"
horizontal_alignment = 1

[node name="Separator" type="HSeparator" parent="Margin/VBox"]
modulate = Color(1, 1, 1, 0.35)
layout_mode = 2
mouse_filter = 2

[node name="PowerLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "+15% item power"
horizontal_alignment = 1
autowrap_mode = 3

[node name="BonusLabel" type="Label" parent="Margin/VBox"]
modulate = Color(0.85, 0.85, 0.8, 1)
layout_mode = 2
text = "Bonus"
horizontal_alignment = 1
autowrap_mode = 3

[node name="SelectButton" type="Button" parent="."]
layout_mode = 2
theme_override_styles/focus = SubResource("StyleBoxEmpty_none")
theme_override_styles/disabled = SubResource("StyleBoxEmpty_none")
theme_override_styles/hover = SubResource("StyleBoxEmpty_none")
theme_override_styles/pressed = SubResource("StyleBoxEmpty_none")
theme_override_styles/normal = SubResource("StyleBoxEmpty_none")
